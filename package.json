{
  "name": "mutant-katas",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:katas": "BUNDLE_GEMFILE=ruby/Gemfile bundle exec ruby ruby/compile_katas.rb",
    "predev": "npm run compile:katas",
    "dev": "vite",
    "prebuild": "npm run compile:katas",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "npm run compile:katas",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:wasm": "ruby/pack.sh"
  },
  "devDependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@ruby/3.3-wasm-wasi": "^2.9.3-2.9.4",
    "@ruby/wasm-wasi": "^2.9.3-2.9.4",
    "happy-dom": "^20.10.6",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6"
  }
}
